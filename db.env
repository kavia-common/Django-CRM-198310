# Placeholder env for local docker-compose Postgres service (SAFE DUMMY VALUES)
# This file exists to provide the variables that the official postgres image expects.
#
# IMPORTANT:
# - Django app services use backend/.env (DBNAME, DBUSER, DBPASSWORD, DBHOST, DBPORT).
# - Postgres service uses POSTGRES_* variables below.
#
# For local development you should keep these in sync with backend/.env:
#   DBNAME     <-> POSTGRES_DB
#   DBUSER     <-> POSTGRES_USER
#   DBPASSWORD <-> POSTGRES_PASSWORD

POSTGRES_DB=bottlecrm
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
