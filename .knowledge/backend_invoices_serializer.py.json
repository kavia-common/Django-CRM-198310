{"is_source_file": true, "format": "Python", "description": "This file contains Django REST Framework serializers for various invoicing-related models, including invoices, estimates, products, recurring invoices, payments, and related entities. It defines both full and lightweight serializers, as well as create/update variants, handling relationships, validation, and serialization logic for API responses and requests within the backend of a CRM/invoicing application.", "external_files": ["rest_framework.serializers", "accounts.models", "accounts.serializer", "common.serializer", "contacts.models", "contacts.serializer", "invoices.models", "opportunity.models"], "external_methods": [], "published": ["OpportunityMinimalSerializer", "ProductSerializer", "ProductCreateSerializer", "InvoiceTemplateSerializer", "InvoiceTemplateCreateSerializer", "InvoiceLineItemSerializer", "InvoiceLineItemCreateSerializer", "PaymentSerializer", "PaymentCreateSerializer", "InvoiceListSerializer", "InvoiceSerializer", "InvoiceCreateSerializer", "InvoiceHistorySerializer", "EstimateLineItemSerializer", "EstimateListSerializer", "EstimateSerializer", "EstimateCreateSerializer", "RecurringInvoiceLineItemSerializer", "RecurringInvoiceListSerializer", "RecurringInvoiceSerializer", "RecurringInvoiceCreateSerializer", "PublicInvoiceSerializer", "PublicEstimateSerializer"], "classes": [{"name": "OpportunityMinimalSerializer", "description": "Minimal serializer for Opportunity model to avoid circular import, including id, name, amount, stage, and currency fields."}, {"name": "ProductSerializer", "description": "Serializer for Product catalog data with fields for id, name, description, sku, price, currency, category, active status, created and updated timestamps."}, {"name": "ProductCreateSerializer", "description": "Serializer for creating or updating Product instances with logic to set default currency based on org from request context."}, {"name": "InvoiceTemplateSerializer", "description": "Seri