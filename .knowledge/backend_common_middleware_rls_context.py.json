{"is_source_file": true, "format": "Python", "description": "This file contains middleware classes for managing PostgreSQL row-level security (RLS) context within a Django application. It defines middleware to set and reset the PostgreSQL session variable 'app.current_org' based on the request's organization context, and includes a stricter version that enforces the presence of an org context. The file also contains SQL comments for enabling RLS policies on various database tables.", "external_files": ["django.db.connection", "django.urls.resolve", "django.urls.exceptions.Resolver404", "rest_framework.exceptions.PermissionDenied"], "external_methods": ["connection.cursor", "logger.debug", "logger.warning"], "published": ["SetOrgContext", "RequireOrgContext", "RLS_SETUP_SQL"], "classes": [{"name": "SetOrgContext", "description": "Middleware that sets the PostgreSQL session variable 'app.current_org' to the user's organization ID before processing the request, and resets it after the request to prevent context leakage."}, {"name": "RequireOrgContext", "description": "Middleware that ensures an org context is present for each request, raising an error if it is missing, used to enforce stricter security after RLS policies are enabled."}], "methods": [{"name": "__init__(self, get_response)", "description": "Initializes middleware with the get_response callback.", "scope": "SetOrgContext", "scopeKind": "class"}, {"name": "__call__(self, request)", "description": "Handles request processing, setting and resetting the org context.", "scope": "SetOrgContext", "scopeKind": "class"}, {"name": "_set_org_context(self, request)", "description": "Sets the PostgreSQL session variable 'app.current_org' to the request's org ID.", "scope": "SetOrgContext", "scopeKind": "class"}, {"name": "_reset_org_context(self)", "description": "Resets the session variable to an empty string after request handling.", "scope": "SetOrgContext", "scopeKind": "class"}, {"name": "_is_exempt(self, path)",