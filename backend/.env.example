# Core Django
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
ENV_TYPE=dev

# Database
DBNAME=
DBUSER=
DBPASSWORD=
DBHOST=
DBPORT=

# Email
DEFAULT_FROM_EMAIL=
ADMIN_EMAIL=

# Celery
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Existing settings referenced by code
DOMAIN_NAME=
SWAGGER_ROOT_URL=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# JWT (optional overrides)
# If omitted, defaults are 60 minutes access token, 14 days refresh token, rotation+blacklist enabled
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=14
JWT_ROTATE_REFRESH_TOKENS=true
JWT_BLACKLIST_AFTER_ROTATION=true
