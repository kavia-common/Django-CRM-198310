# Backend environment variables required to run Django management commands locally/CI.
# NOTE: Do not put secrets in this file. Provide real values via the actual .env in the runtime environment.

# Django
SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_SETTINGS_MODULE=crm.settings

# Optional but commonly required (uncomment/provide if used by settings)
# DEBUG=false
# ALLOWED_HOSTS=localhost,127.0.0.1

# Database (provide according to this project's settings.py expectations)
# DATABASE_URL=postgres://user:password@host:5432/dbname
# or if discrete vars are used:
# POSTGRES_HOST=
# POSTGRES_PORT=
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=

# Auth / JWT (if required by settings)
# JWT_SIGNING_KEY=

# Site URL / CORS / CSRF (if required)
# SITE_URL=http://localhost:5173

# Redis / Celery (if required)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
